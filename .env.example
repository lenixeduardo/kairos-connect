# KairOS Connect - Configuração de Variáveis de Ambiente
# Copie este arquivo para ".env" ou ".env.local" para personalizar

# ── Integração com KairOS (sistema de manutenção industrial) ──────────────────
# URL do backend KairOS. O padrão já aponta para produção — só altere se
# quiser usar um backend local ou de staging.
# Para desenvolvimento local: VITE_KAIROS_API_URL=http://localhost:3333
VITE_KAIROS_API_URL=https://maintech-backend-v8bl.onrender.com

# ── Modo demo (sem backend) ───────────────────────────────────────────────────
# Usado apenas quando VITE_KAIROS_API_URL não está definida (não recomendado).
VITE_ADMIN_EMAIL=admin@admin.com
VITE_ADMIN_PASSWORD=admin
