# KairOS Connect - Configuração de Variáveis de Ambiente
# Copie este arquivo para ".env" ou ".env.local" para personalizar

# ── Integração com KairOS (sistema de manutenção industrial) ──────────────────
# URL do backend KairOS (maintech). Quando definida, o login e as views de
# Ordens de Serviço e Máquinas se conectam à API real.
# Exemplo: VITE_KAIROS_API_URL=https://seu-backend.onrender.com
VITE_KAIROS_API_URL=

# ── Modo demo (sem backend) ───────────────────────────────────────────────────
# Usado apenas quando VITE_KAIROS_API_URL não está definida.
VITE_ADMIN_EMAIL=admin@admin.com
VITE_ADMIN_PASSWORD=admin
